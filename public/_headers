# Cloudflare Pages response headers.
# Build output under /_next/static has content hashes in its names, so it never changes in place.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Work images keep their names when a master is replaced, so cache them for a week, not forever.
/work/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
